<ui:FluentWindow
    x:Class="VideoLocalizer.Views.FindReplaceSubtitleDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:model="clr-namespace:VideoLocalizer.Models"
    Title="Tìm và thay thế SRT"
    Width="760" Height="560"
    MinWidth="640" MinHeight="480"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True">

    <Grid Margin="16,8,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Tìm và thay thế SRT" Margin="-16,-8,-16,0"/>

        <Grid Grid.Row="1" Margin="0,14,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Từ cần tìm:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

            <TextBox Grid.Column="1"
                     Name="TxtFind"
                     KeyDown="TxtFind_KeyDown"
                     ToolTip="Tìm gần đúng theo đoạn chứa chuỗi nhập, có tính cả khoảng trắng"
                     Padding="8,6"/>

            <ui:Button Grid.Column="2"
                       Name="BtnSearch"
                       Content="Tìm kiếm"
                       Click="BtnSearch_Click"
                       Margin="8,0,0,0"/>
        </Grid>

        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Thay thế bằng:"
                       VerticalAlignment="Center"
                       FontWeight="SemiBold"/>

            <TextBox Grid.Column="1"
                     Name="TxtReplace"
                     Padding="8,6"
                     ToolTip="Chuỗi mới để thay toàn bộ kết quả khớp"/>
        </Grid>

        <DockPanel Grid.Row="3" Margin="0,0,0,10">
            <TextBlock Name="TxtResultSummary"
                       DockPanel.Dock="Left"
                       VerticalAlignment="Center"
                       TextWrapping="Wrap"
                       Foreground="#DDDDDD"
                       Text="Nhập từ cần tìm để xem danh sách đoạn SRT khớp."/>

            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="12,0,0,0">
                <ui:Button Name="BtnReplaceAll"
                           Content="Thay thế toàn bộ"
                           Click="BtnReplaceAll_Click"
                           Appearance="Primary"
                           IsEnabled="False"
                           Margin="0,0,8,0"/>
                <ui:Button Content="Đóng"
                           Click="BtnClose_Click"/>
            </StackPanel>
        </DockPanel>

        <Border Grid.Row="4" BorderBrush="#3A3A3A" BorderThickness="1" CornerRadius="4">
            <ListBox Name="LstMatches"
                     Margin="0"
                     HorizontalContentAlignment="Stretch"
                     ScrollViewer.VerticalScrollBarVisibility="Auto">
                <ListBox.ItemTemplate>
                    <DataTemplate DataType="{x:Type model:SubtitleEntry}">
                        <Border BorderBrush="#2F2F2F" BorderThickness="0,0,0,1" Padding="10,8">
                            <StackPanel>
                                <TextBlock>
                                    <Run Text="Dòng "/>
                                    <Run Text="{Binding Index, Mode=OneWay}" FontWeight="SemiBold"/>
                                    <Run Text="  (" Foreground="#A8A8A8"/>
                                    <Run Text="{Binding StartTimeDisplay, Mode=OneWay}" Foreground="#A8A8A8"/>
                                    <Run Text=" -> " Foreground="#A8A8A8"/>
                                    <Run Text="{Binding EndTimeDisplay, Mode=OneWay}" Foreground="#A8A8A8"/>
                                    <Run Text=")" Foreground="#A8A8A8"/>
                                </TextBlock>
                                <TextBlock Text="{Binding Text, Mode=OneWay}"
                                           Margin="0,4,0,0"
                                           TextWrapping="Wrap"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="5"
                   Margin="0,10,0,0"
                   Foreground="#A8A8A8"
                   TextWrapping="Wrap"
                   Text="Lưu ý: Chức năng này chỉ chỉnh dữ liệu trên danh sách SRT hiện tại. Muốn ghi file, bạn cần bấm nút Lưu SRT thủ công."/>
    </Grid>
</ui:FluentWindow>
