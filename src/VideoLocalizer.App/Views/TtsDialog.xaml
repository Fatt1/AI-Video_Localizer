<!-- Views/TtsDialog.xaml -->
<!-- Popup tạo giọng nói độc lập: nhập text, chọn voice, điều chỉnh tốc độ, nghe lại -->
<ui:FluentWindow
    x:Class="VideoLocalizer.Views.TtsDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    Title="Tạo giọng nói"
    Width="680" Height="580"
    MinWidth="560" MinHeight="440"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False"
    ExtendsContentIntoTitleBar="True">

    <ui:FluentWindow.Resources>
        <!-- Style dòng audio trong ListView -->
        <Style x:Key="AudioItemStyle" TargetType="ListViewItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>  <!-- TitleBar -->
            <RowDefinition Height="*"/>     <!-- Content -->
        </Grid.RowDefinitions>

        <!-- Title bar -->
        <ui:TitleBar Grid.Row="0" Title="🎙️ Tạo giọng nói" Margin="0,0,0,0"/>

        <!-- Main content -->
        <Grid Grid.Row="1" Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>  <!-- Voice + Speed -->
                <RowDefinition Height="Auto"/>  <!-- Text input label -->
                <RowDefinition Height="120"/>   <!-- Text input -->
                <RowDefinition Height="Auto"/>  <!-- Generate button -->
                <RowDefinition Height="Auto"/>  <!-- Status -->
                <RowDefinition Height="*"/>     <!-- Audio list -->
                <RowDefinition Height="Auto"/>  <!-- Bottom buttons -->
            </Grid.RowDefinitions>

            <!-- ── Row 0: Voice selector + Speed slider ── -->
            <Grid Grid.Row="0" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="16"/>
                    <ColumnDefinition Width="220"/>
                </Grid.ColumnDefinitions>

                <!-- Voice selector -->
                <GroupBox Grid.Column="0" Header="Giọng đọc" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <ComboBox Name="CboEngine"
                                      ToolTip="Chọn TTS Engine"
                                      Margin="0,0,0,4"
                                      SelectionChanged="CboEngine_SelectionChanged">
                                <ComboBoxItem Content="omnivoice"/>
                                <ComboBoxItem Content="vieneu"/>
                            </ComboBox>
                            <ComboBox Name="CboVoice"
                                      DisplayMemberPath="Name"
                                      SelectedValuePath="Id"
                                      ToolTip="Chọn voice clone để tổng hợp giọng nói"/>
                        </StackPanel>
                        <ui:Button Grid.Column="1"
                                   Name="BtnRefreshVoices"
                                   Icon="{ui:SymbolIcon ArrowClockwise24}"
                                   Margin="6,0,0,0"
                                   ToolTip="Tải lại danh sách voice"
                                   Click="BtnRefreshVoices_Click"/>
                    </Grid>
                </GroupBox>

                <!-- Speed slider -->
                <GroupBox Grid.Column="2" Header="Tốc độ đọc" Padding="8,4">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="40"/>
                        </Grid.ColumnDefinitions>
                        <Slider Name="SliderSpeed"
                                Grid.Column="0"
                                Minimum="0.5" Maximum="2.0"
                                Value="1.0"
                                TickFrequency="0.1"
                                IsSnapToTickEnabled="True"
                                VerticalAlignment="Center"
                                ValueChanged="SliderSpeed_ValueChanged"/>
                        <TextBlock Name="TxtSpeedValue"
                                   Grid.Column="1"
                                   Text="1.0x"
                                   VerticalAlignment="Center"
                                   HorizontalAlignment="Center"
                                   FontWeight="SemiBold"
                                   Margin="4,0,0,0"/>
                    </Grid>
                </GroupBox>
            </Grid>

            <!-- ── Row 1: Text label ── -->
            <TextBlock Grid.Row="1"
                       Text="Văn bản cần đọc:"
                       FontWeight="SemiBold"
                       Margin="0,0,0,4"/>

            <!-- ── Row 2: Text input ── -->
            <TextBox Grid.Row="2"
                     Name="TxtInput"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     FontSize="13"
                     Padding="8,6"
                     ToolTip="Nhập văn bản muốn tổng hợp thành giọng nói (Enter để xuống dòng)"
                     KeyDown="TxtInput_KeyDown"/>

            <!-- ── Row 3: Generate button ── -->
            <Grid Grid.Row="3" Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Name="TxtInputHint"
                           Grid.Column="0"
                           Text="Ctrl+Enter để tạo nhanh"
                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                           VerticalAlignment="Center"
                           FontSize="11"/>

                <ui:Button Grid.Column="1"
                           Name="BtnGenerate"
                           Content="🎙️ Tạo giọng nói"
                           Appearance="Primary"
                           Icon="{ui:SymbolIcon MicRecord24}"
                           Click="BtnGenerate_Click"
                           MinWidth="160"
                           IsEnabled="False"/>
            </Grid>

            <!-- ── Row 4: Status bar ── -->
            <Border Grid.Row="4"
                    Margin="0,8,0,0"
                    Padding="8,6"
                    CornerRadius="4"
                    Background="{DynamicResource ControlFillColorDefaultBrush}"
                    Visibility="{Binding StatusVisibility, RelativeSource={RelativeSource AncestorType=Window}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <ui:ProgressRing Name="ProgressRing"
                                     Grid.Column="0"
                                     Width="16" Height="16"
                                     IsIndeterminate="True"
                                     Margin="0,0,8,0"
                                     Visibility="Collapsed"/>
                    <TextBlock Name="TxtStatus"
                               Grid.Column="1"
                               TextWrapping="Wrap"
                               FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                </Grid>
            </Border>

            <!-- ── Row 5: Danh sách audio đã tạo ── -->
            <GroupBox Grid.Row="5"
                      Margin="0,10,0,0"
                      Padding="6,4">
                <GroupBox.Header>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="📂 Danh sách audio đã tạo" FontWeight="SemiBold"/>
                        <TextBlock Name="TxtAudioCount"
                                   Text=" (0)"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   FontSize="11"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                </GroupBox.Header>

                <ListView Name="LvAudioList"
                          ItemContainerStyle="{StaticResource AudioItemStyle}"
                          SelectionMode="Single">
                    <ListView.View>
                        <GridView>
                            <GridViewColumn Header="Tên file" Width="160"
                                            DisplayMemberBinding="{Binding AudioFilename}"/>
                            <GridViewColumn Header="Văn bản" Width="240"
                                            DisplayMemberBinding="{Binding Text}"/>
                            <GridViewColumn Header="Tốc độ" Width="58">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding SpeechRate, StringFormat={}{0:F1}x}"
                                                   HorizontalAlignment="Center"/>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                            <GridViewColumn Header="Voice" Width="90"
                                            DisplayMemberBinding="{Binding VoiceId}"/>
                            <GridViewColumn Header="" Width="76">
                                <GridViewColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <ui:Button Content="▶"
                                                       ToolTip="Phát audio"
                                                       Padding="6,3"
                                                       FontSize="11"
                                                       Margin="0,0,4,0"
                                                       Tag="{Binding AudioFilename}"
                                                       Click="BtnPlayAudio_Click"/>
                                            <ui:Button Content="💾"
                                                       ToolTip="Mở thư mục chứa file"
                                                       Padding="6,3"
                                                       FontSize="11"
                                                       Tag="{Binding AudioPath}"
                                                       Click="BtnOpenFolder_Click"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </GridViewColumn.CellTemplate>
                            </GridViewColumn>
                        </GridView>
                    </ListView.View>
                </ListView>
            </GroupBox>

            <!-- ── Row 6: Bottom buttons ── -->
            <StackPanel Grid.Row="6"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,10,0,0">
                <ui:Button Name="BtnClearList"
                           Content="Xóa danh sách"
                           Icon="{ui:SymbolIcon Delete24}"
                           Margin="0,0,8,0"
                           Click="BtnClearList_Click"
                           ToolTip="Xóa danh sách (không xóa file trên ổ đĩa)"/>
                <ui:Button Name="BtnClose"
                           Content="Đóng"
                           Appearance="Secondary"
                           Click="BtnClose_Click"
                           Width="80"/>
            </StackPanel>
        </Grid>
    </Grid>
</ui:FluentWindow>
