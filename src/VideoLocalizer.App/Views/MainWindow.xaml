<!-- Views/MainWindow.xaml -->
<!-- Layout chính: Menu trên → Content (Video trái 60%, Panel phải 40%) → Status bar dưới -->
<ui:FluentWindow
    x:Class="VideoLocalizer.Views.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
    xmlns:vlc="clr-namespace:LibVLCSharp.WPF;assembly=LibVLCSharp.WPF"
    xmlns:vm="clr-namespace:VideoLocalizer.ViewModels"
    xmlns:conv="clr-namespace:VideoLocalizer.Converters"
    Title="AI Video Localizer"
    Width="1280" Height="800"
    MinWidth="900" MinHeight="600"
    WindowStartupLocation="CenterScreen"
    ExtendsContentIntoTitleBar="True">

    <!-- ═══════════════════════════════════════════════
         RESOURCES: Converters + Styles dùng trong file này
    ═══════════════════════════════════════════════════ -->
    <ui:FluentWindow.Resources>
        <conv:TimeSpanConverter x:Key="TimeSpanConverter"/>
        <conv:BoolToVisibilityConverter x:Key="BoolToVisibility"/>
        <conv:BoolToVisibilityConverter x:Key="InvertBoolToVisibility"/>
    </ui:FluentWindow.Resources>

    <!-- DataContext = MainViewModel (toàn bộ binding đều qua đây) -->
    <ui:FluentWindow.DataContext>
        <vm:MainViewModel/>
    </ui:FluentWindow.DataContext>

    <!-- ═══════════════════════════════════════════════
         ROOT LAYOUT: Grid 3 hàng = Menu (Top) + Content (Fill) + StatusBar (Bottom)
    ═══════════════════════════════════════════════════ -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Row 0: TitleBar -->
            <RowDefinition Height="*"/>    <!-- Row 1: Content -->
            <RowDefinition Height="Auto"/> <!-- Row 2: StatusBar -->
        </Grid.RowDefinitions>

        <!-- ─── TITLE BAR + MENU (Row 0) ─── -->
        <ui:TitleBar Grid.Row="0" Title="AI Video Localizer">
            <!-- Menu nằm trong custom title bar area -->
            <ui:TitleBar.Header>
                <Menu Background="Transparent" VerticalAlignment="Center" Margin="8,0,0,0">

                    <!-- File Menu -->
                    <MenuItem Header="_File">
                        <MenuItem Header="Mở Video..." Command="{Binding OpenVideoCommand}"
                                  InputGestureText="Ctrl+O"/>
                        <MenuItem Header="Load SRT..." Command="{Binding LoadSrtCommand}"/>
                        <MenuItem Header="Load SRT việt sub để so sánh..." Command="{Binding LoadCompareSrtCommand}"/>
                        <MenuItem Header="Lưu SRT" Command="{Binding SaveSrtCommand}"
                                  InputGestureText="Ctrl+S"/>
                        <Separator/>
                        <MenuItem Header="Thoát" Click="MenuExit_Click"/>
                    </MenuItem>

                    <!-- Tools Menu -->
                    <MenuItem Header="_Tools">
                        <!-- IsChecked bind để hiện trạng thái OCR mode đang bật/tắt -->
                        <MenuItem Header="Chọn vùng OCR..."
                                  Name="MenuSelectOcrRegion"
                                  IsCheckable="True"
                                  Click="MenuSelectOcrRegion_Click"
                                  ToolTip="Kéo chuột trên video để chọn vùng có hardsub"/>
                        <MenuItem Header="OCR Hardsub..." Name="MenuOcr" Click="MenuOcr_Click"/>
                        <MenuItem Header="Dịch SRT..." Name="MenuTranslate" Click="MenuTranslate_Click"/>
                        <MenuItem Header="Chuẩn hóa trước khi dịch (Export Plain)..."
                                  Command="{Binding ExportPlainSubtitleCommand}"
                                  ToolTip="Xuất plain subtitle (index + text, không timestamp) để đưa vào AI dịch"/>
                        <MenuItem Header="Chuẩn hóa SRT sau khi dịch (Merge)..."
                                  Command="{Binding MergeSrtCommand}"
                                  ToolTip="Ghép timestamp từ ocr.srt vào file plain đã dịch → tạo vietsub"/>
                        <MenuItem Header="Tìm &amp; thay thế SRT..." Name="MenuFindReplace" Click="MenuFindReplace_Click"/>
                        <Separator/>
                        <MenuItem Header="Speech-to-Text (Fun-ASR-Nano)..." Name="MenuStt" Click="MenuStt_Click"
                                  ToolTip="Nhận dạng giọng nói từ video tiếng Trung → SRT"/>
                        <MenuItem Header="Dubbing (OmniVoice -> CapCut)..." Name="MenuDubbing" Click="MenuDubbing_Click"/>
                    </MenuItem>

                    <!-- Settings Menu -->
                    <MenuItem Header="_Cài đặt" Click="MenuSettings_Click"/>

                </Menu>
            </ui:TitleBar.Header>
        </ui:TitleBar>

        <!-- ─── STATUS BAR (Row 2) ─── -->
        <StatusBar Grid.Row="2" Height="28">
            <StatusBarItem>
                <!-- Icon kết nối backend: xanh = connected, đỏ = disconnected -->
                <StackPanel Orientation="Horizontal" Margin="4,0">
                    <Ellipse Width="10" Height="10" Margin="0,0,6,0">
                        <Ellipse.Style>
                            <Style TargetType="Ellipse">
                                <Setter Property="Fill" Value="#FF4444"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsBackendConnected}" Value="True">
                                        <Setter Property="Fill" Value="#44FF88"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Ellipse.Style>
                    </Ellipse>
                    <TextBlock Text="{Binding StatusMessage}" VerticalAlignment="Center"/>
                </StackPanel>
            </StatusBarItem>

            <!-- Separator đẩy Progress sang phải -->
            <StatusBarItem HorizontalAlignment="Right">
                <!-- Chỉ hiện khi IsBusy = true -->
                <StackPanel Orientation="Horizontal"
                            Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
                    <!-- % tiến độ -->
                    <TextBlock Text="{Binding TaskProgress, StringFormat={}{0}%}"
                               VerticalAlignment="Center" Margin="0,0,6,0" FontSize="11"/>
                    <ProgressBar Height="10" Width="160"
                                 Value="{Binding TaskProgress}"/>
                </StackPanel>
            </StatusBarItem>
        </StatusBar>

        <!-- ═══════════════════════════════════════════════
             MAIN CONTENT: Grid 2 cột (Video 60% | Panel phải 40%)
        ═══════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Cột trái: Video player (60% = 3*) -->
                <ColumnDefinition Width="3*"/>
                <!-- Splitter: user có thể kéo để điều chỉnh tỷ lệ -->
                <ColumnDefinition Width="4"/>
                <!-- Cột phải: Style + Glossary + DataGrid (40% = 2*) -->
                <ColumnDefinition Width="2*"/>
            </Grid.ColumnDefinitions>

            <!-- ─── PANEL TRÁI: VIDEO PLAYER ─── -->
            <Grid Grid.Column="0">
                <Grid.RowDefinitions>
                    <!-- Video view chiếm phần lớn -->
                    <RowDefinition Height="*"/>
                    <!-- Transport controls (Play/Pause/Seek/Volume) -->
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- LibVLCSharp VideoView + Canvas overlay trong 1 Grid
                     Grid.Row="0" để cả 2 chiếm cùng ô, overlap nhau -->
                <Grid Grid.Row="0">

                    <!-- Video render ở đây -->
                    <vlc:VideoView Name="VideoView" Background="Black"/>

                    <!-- Placeholder overlay khi đang chọn vùng OCR.
                         Khi vào OCR mode, hiển thị snapshot frame để user chọn chính xác vị trí subtitle. -->
                    <Grid Name="OcrPlaceholder"
                          Visibility="Collapsed">
                        <Image Name="OcrSnapshotImage"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>

                        <Border Background="#44000000">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <TextBlock Text="🖱 Kéo chuột để khoanh vùng có subtitle"
                                           Foreground="White" FontSize="15" FontWeight="SemiBold"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="(thường ở 70–90% chiều cao video)"
                                           Foreground="#AAAAAA" FontSize="12" Margin="0,6,0,0"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="Nhấn Esc hoặc bỏ tick menu để hủy"
                                           Foreground="#888888" FontSize="11" Margin="0,4,0,0"
                                           HorizontalAlignment="Center"/>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Canvas overlay: dùng để user kéo chọn vùng OCR
                         IsHitTestVisible=False khi không ở OCR mode → không block click video -->
                    <Canvas Name="OcrCanvas"
                            Background="Transparent"
                            IsHitTestVisible="False"
                            Cursor="Cross"
                            MouseLeftButtonDown="OcrCanvas_MouseDown"
                            MouseMove="OcrCanvas_MouseMove"
                            MouseLeftButtonUp="OcrCanvas_MouseUp">

                        <!-- Rectangle hiển thị vùng OCR đã chọn (luôn hiện khi có vùng chọn) -->
                        <Rectangle Name="OcrSelectionRect"
                                   Stroke="#FFD700"
                                   StrokeThickness="2"
                                   Fill="#33FFD700"
                                   StrokeDashArray="6 3"
                                   Visibility="Collapsed"/>

                        <!-- Label hiển thị "OCR Region" ở góc trên của hộp chọn -->
                        <Border Name="OcrLabelBorder"
                                Background="#CC000000"
                                CornerRadius="3"
                                Padding="4,2"
                                Visibility="Collapsed">
                            <TextBlock Name="OcrLabel"
                                       Text="OCR Region"
                                       Foreground="#FFD700"
                                       FontSize="11"/>
                        </Border>

                    </Canvas>

                </Grid>

                <!-- Transport controls bar -->
                <Border Grid.Row="1" Background="#1E1E1E" Padding="8,6">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>  <!-- Play/Pause button -->
                            <ColumnDefinition Width="*"/>     <!-- Seek slider -->
                            <ColumnDefinition Width="Auto"/>  <!-- Time label -->
                            <ColumnDefinition Width="Auto"/>  <!-- Volume icon -->
                            <ColumnDefinition Width="80"/>    <!-- Volume slider -->
                        </Grid.ColumnDefinitions>

                        <!-- Nút Play/Pause (dùng UI icon) -->
                        <ui:Button Grid.Column="0"
                                   Name="BtnPlayPause"
                                   Icon="{ui:SymbolIcon Play24}"
                                   Click="BtnPlayPause_Click"
                                   Margin="0,0,8,0"
                                   ToolTip="Play/Pause (Space)"/>

                        <!-- Seek slider — giá trị 0.0 → 1.0 (% tiến độ video)
                             IsMoveToPointEnabled="True": click đâu thì nhảy đúng đó
                             LargeChange="0.05": phím PgUp/Down tua 5%
                             KHÔNG dùng PreviewMouseDown/Up vì gây bug LargeChange -->
                        <Slider Grid.Column="1" Name="SeekSlider"
                                Minimum="0" Maximum="1"
                                SmallChange="0.005"
                                LargeChange="0.05"
                                IsMoveToPointEnabled="True"
                                VerticalAlignment="Center"
                                Loaded="SeekSlider_Loaded"/>

                        <!-- Hiển thị thời gian hiện tại / tổng -->
                        <TextBlock Grid.Column="2" Name="TxtTime"
                                   Text="00:00 / 00:00"
                                   VerticalAlignment="Center"
                                   Margin="8,0" FontSize="11"
                                   Foreground="White"/>

                        <!-- Volume icon -->
                        <ui:SymbolIcon Grid.Column="3" Symbol="Speaker224"
                                       Margin="8,0,4,0" VerticalAlignment="Center"/>

                        <!-- Volume slider 0–100 -->
                        <Slider Grid.Column="4" Name="VolumeSlider"
                                Minimum="0" Maximum="100" Value="80"
                                VerticalAlignment="Center"
                                ValueChanged="VolumeSlider_ValueChanged"/>
                    </Grid>
                </Border>
            </Grid>

            <!-- GridSplitter: cho phép user kéo dãn cột -->
            <GridSplitter Grid.Column="1"
                          Width="4" HorizontalAlignment="Stretch"
                          Background="#333"/>

            <!-- ─── PANEL PHẢI: Canh bao loi SRT + DataGrid ─── -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <!-- Danh sach dong nghi loi -->
                    <RowDefinition Height="Auto"/>
                    <!-- Row phu de groupbox canh bao row-span -->
                    <RowDefinition Height="Auto"/>
                    <!-- Toolbar (Load SRT, Save, Export) -->
                    <RowDefinition Height="Auto"/>
                    <!-- STT section -->
                    <RowDefinition Height="Auto"/>
                    <!-- Dubbing section -->
                    <RowDefinition Height="Auto"/>
                    <!-- DataGrid (chiếm phần còn lại) -->
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- ── Danh sach cac dong SRT co kha nang loi thoi luong (< 1s) ── -->
                <GroupBox Grid.Row="0"
                          Grid.RowSpan="2"
                          Header="Dong SRT co kha nang loi (&lt; 1 giay)"
                          Margin="6,6,6,0"
                          Padding="6,4">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="190"/>
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   Text="{Binding ShortDurationWarningMessage}"
                                   Foreground="#FFB366"
                                   FontWeight="SemiBold"
                                   Margin="0,0,0,6"/>

                        <DataGrid Grid.Row="1"
                                  ItemsSource="{Binding SuspectedShortDurationSubtitles}"
                                  AutoGenerateColumns="False"
                                  CanUserAddRows="False"
                                  CanUserDeleteRows="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single"
                                  GridLinesVisibility="Horizontal"
                                  Margin="0">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="#"
                                                   Binding="{Binding Index}"
                                                   Width="40"/>

                                <DataGridTextColumn Header="Bat dau"
                                                   Binding="{Binding StartTime,
                                                       Converter={StaticResource TimeSpanConverter}}"
                                                   Width="90"/>

                                <DataGridTextColumn Header="Ket thuc"
                                                   Binding="{Binding EndTime,
                                                       Converter={StaticResource TimeSpanConverter}}"
                                                   Width="90"/>

                                <DataGridTextColumn Header="Noi dung"
                                                   Binding="{Binding Text}"
                                                   Width="*">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextWrapping" Value="Wrap"/>
                                            <Setter Property="MaxHeight" Value="60"/>
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </GroupBox>

                <!-- ── Subtitle Toolbar ── -->
                <ToolBar Grid.Row="2" Margin="6,4,6,0">
                    <ToolBar.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" IsItemsHost="True"/>
                        </ItemsPanelTemplate>
                    </ToolBar.ItemsPanel>
                    <ui:Button Content="Load SRT"
                               Command="{Binding LoadSrtCommand}"
                               Icon="{ui:SymbolIcon DocumentAdd24}"
                               Margin="0,0,4,4"/>
                    <ui:Button Content="Lưu SRT"
                               Command="{Binding SaveSrtCommand}"
                               Icon="{ui:SymbolIcon Save24}"
                               Margin="0,0,4,4"/>
                    <ui:Button Content="Lọc lặp SRT"
                               Command="{Binding FilterDuplicateSubtitlesCommand}"
                               Margin="0,0,4,4"
                               ToolTip="Gộp các dòng lặp liên tiếp: giữ Start dòng đầu và End dòng cuối"/>
                    <ui:Button Content="So sánh SRT"
                               Command="{Binding CompareSrtCommand}"
                               Icon="{ui:SymbolIcon Search24}"
                               Margin="0,0,4,4"
                               ToolTip="So sánh thời gian SRT gốc và SRT dịch"/>
                    <ui:Button Content="Tìm/Thay thế"
                               Name="BtnFindReplace"
                               Click="BtnFindReplace_Click"
                               Margin="0,0,4,4"
                               ToolTip="Tìm gần đúng trong SRT và thay thế toàn bộ trên danh sách hiện tại"/>
                    <Separator Margin="0,0,4,4"/>

                    <ui:Button Name="BtnRunStt"
                               Content="Speech-to-Text"
                               Command="{Binding RunSttCommand}"
                               Icon="{ui:SymbolIcon MicRecord24}"
                               ToolTip="Nhận dạng giọng nói từ video (Fun-ASR-Nano Tiếng Trung) → SRT"
                               Margin="0,0,4,4"/>

                    <!-- Nút chạy OCR: bind vào RunOcrCommand (có CanExecute = !IsBusy) -->
                    <ui:Button Name="BtnRunOcr"
                               Content="Chạy OCR"
                               Command="{Binding RunOcrCommand}"
                               Icon="{ui:SymbolIcon ScanObject24}"
                               ToolTip="Nhận diện chữ từ video (Hardsub OCR)"
                               Margin="0,0,4,4"/>

                    <!-- Nút Chuẩn hóa trước khi dịch: xuất plain subtitle từ SRT để đưa vào AI dịch -->
                    <ui:Button Name="BtnExportPlain"
                               Content="Chuẩn hóa trước dịch"
                               Command="{Binding ExportPlainSubtitleCommand}"
                               Icon="{ui:SymbolIcon DocumentText24}"
                               ToolTip="Xuất plain subtitle (index + text, không timestamp) để dịch bằng AI"
                               Margin="0,0,4,4"/>

                    <!-- Nút dịch: bind vào RunTranslateCommand -->
                    <ui:Button Name="BtnTranslate"
                               Content="Dịch SRT"
                               Command="{Binding RunTranslateCommand}"
                               Icon="{ui:SymbolIcon Translate24}"
                               ToolTip="Chỉ dịch SRT sang tiếng Việt (không tạo audio CapCut)"
                               Margin="0,0,4,4"/>

                    <!-- Nút Chuẩn hóa SRT: ghép timestamp từ ocr.srt vào file plain đã dịch -->
                    <ui:Button Name="BtnMergeSrt"
                               Content="Chuẩn hóa SRT"
                               Command="{Binding MergeSrtCommand}"
                               Icon="{ui:SymbolIcon DocumentSync24}"
                               ToolTip="Ghép timestamp từ ocr.srt vào file plain đã dịch → tạo vietsub hoàn chỉnh"
                               Margin="0,0,4,4"/>

                    <Separator Margin="0,0,4,4"/>

                    <!-- Nút Hủy: chỉ active khi đang có task chạy (IsBusy = true) -->
                    <ui:Button Name="BtnCancel"
                               Content="Hủy"
                               Command="{Binding CancelCurrentTaskCommand}"
                               Icon="{ui:SymbolIcon Dismiss24}"
                               Appearance="Danger"
                               Margin="0,0,4,4"
                               ToolTip="Hủy task đang chạy"/>
                </ToolBar>

                <!-- ── STT / Fun-ASR-Nano Section ── -->
                <GroupBox Grid.Row="3" Header="Speech-to-Text (Fun-ASR-Nano → Tiếng Trung)"
                          Margin="6,4,6,0" Padding="6,4">
                    <StackPanel>
                        <!-- Cấu hình số ký tự tối đa / dòng SRT -->
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Ký tự/dòng:" Width="90" VerticalAlignment="Center"
                                       ToolTip="Số ký tự tối đa trên 1 dòng SRT (khuyến nghị 35–42)"/>
                            <TextBlock Text="{Binding SttMaxCharsPerLine, StringFormat={}{0} ký tự}"
                                       Width="66" Margin="6,0,0,0" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       FontWeight="SemiBold"/>
                            <Slider Minimum="20" Maximum="80"
                                    TickFrequency="1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding SttMaxCharsPerLine, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    ToolTip="Kéo để chọn số ký tự tối đa mỗi dòng SRT"/>
                        </DockPanel>

                        <!-- Hint text nhỏ -->
                        <TextBlock Text="Trần ký tự: dòng có thể ngắn hơn nếu có khoảng lặng"
                                   FontSize="10" Foreground="Gray" Margin="0,0,0,4"
                                   TextWrapping="Wrap"/>

                        <!-- Cấu hình khoảng lặng để ngắt dòng -->
                        <DockPanel Margin="0,0,0,4">
                            <TextBlock Text="Khoảng lặng:" Width="90" VerticalAlignment="Center"
                                       ToolTip="Nếu khoảng nghỉ giữa 2 âm tiết >= giá trị này → ngắt dòng SRT mới dù dòng còn ngắn"/>
                            <TextBlock Text="{Binding SttSilenceGapS, StringFormat={}{0:0.0}s}"
                                       Width="66" Margin="6,0,0,0" VerticalAlignment="Center"
                                       HorizontalAlignment="Right"
                                       DockPanel.Dock="Right"
                                       FontWeight="SemiBold"/>
                            <Slider Minimum="0.5" Maximum="5.0"
                                    TickFrequency="0.1"
                                    IsSnapToTickEnabled="True"
                                    Value="{Binding SttSilenceGapS, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"
                                    ToolTip="Kéo để chọn khoảng lặng tối thiểu để ngắt subtitle (giây)"/>
                        </DockPanel>

                        <TextBlock Text="Khuyến nghị: 1.0–2.0s (ngắt khi người ta dừng &gt;= Xs)"
                                   FontSize="10" Foreground="Gray" Margin="0,0,0,6"
                                   TextWrapping="Wrap"/>

                        <ui:Button Content="Nhận dạng giọng nói → SRT"
                                   Command="{Binding RunSttCommand}"
                                   Icon="{ui:SymbolIcon MicRecord24}"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Primary"
                                   ToolTip="Fun-ASR-Nano: nhận dạng tiếng Trung từ video → tạo SRT với timestamps"/>
                    </StackPanel>
                </GroupBox>

                <!-- ── Dubbing / OmniVoice Section ── -->
                <GroupBox Grid.Row="4" Header="Dubbing (OmniVoice -> CapCut)"
                          Margin="6,4,6,0" Padding="6,4">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="Voice:" Width="60" VerticalAlignment="Center"/>
                            <ui:Button DockPanel.Dock="Right"
                                       Icon="{ui:SymbolIcon ArrowSync24}"
                                       Command="{Binding RefreshVoicesCommand}"
                                       ToolTip="Refresh danh sách voice"
                                       Margin="6,0,0,0"/>
                            <ComboBox ItemsSource="{Binding VoiceClones}"
                                      SelectedItem="{Binding SelectedVoice}"
                                      DisplayMemberPath="Name"/>
                        </DockPanel>

                        <DockPanel Margin="0,0,0,6">
                            <TextBlock Text="CapCut:" Width="60" VerticalAlignment="Center"/>
                            <TextBox Text="{Binding CapcutProjectName, UpdateSourceTrigger=PropertyChanged}"
                                     ToolTip="Tên project trong CapCut"/>
                        </DockPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <TextBlock Text="Tốc độ:" Width="60" VerticalAlignment="Center"/>
                            <Slider Minimum="0.5" Maximum="2.0" TickFrequency="0.05"
                                    IsSnapToTickEnabled="False"
                                    Value="{Binding SpeechRate, UpdateSourceTrigger=PropertyChanged}"
                                    VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding SpeechRate, StringFormat={}{0:0.00}x}"
                                       Width="52" Margin="8,0,0,0"
                                       VerticalAlignment="Center"/>
                        </StackPanel>

                        <ui:Button Content="Tạo Audio -> CapCut"
                                   Command="{Binding RunDubbingCommand}"
                                   Icon="{ui:SymbolIcon Mic24}"
                                   HorizontalAlignment="Stretch"
                                   Appearance="Primary"
                                   ToolTip="OmniVoice TTS + inject vào CapCut project"/>
                    </StackPanel>
                </GroupBox>

                <!-- ── DataGrid: hiển thị subtitle entries ── -->
                <!-- SelectedItem bind → ViewModel.SelectedSubtitle để sync với video -->
                <!-- MouseDoubleClick: double-click dòng → seek video đến timestamp đó -->
                <DataGrid Grid.Row="5"
                          Name="SubtitleGrid"
                          ItemsSource="{Binding Subtitles}"
                          SelectedItem="{Binding SelectedSubtitle}"
                          AutoGenerateColumns="False"
                          CanUserAddRows="False"
                          CanUserDeleteRows="False"
                          SelectionMode="Single"
                          GridLinesVisibility="Horizontal"
                          SelectionChanged="SubtitleGrid_SelectionChanged"
                          MouseDoubleClick="SubtitleGrid_MouseDoubleClick"
                          KeyDown="SubtitleGrid_KeyDown"
                          Margin="6,4,6,6">

                    <!-- Context menu: click chuột phải trên dòng -->
                    <DataGrid.ContextMenu>
                        <ContextMenu Opened="SubtitleContextMenu_Opened">
                            <MenuItem Name="CtxAddBefore" Header="➕ Thêm trước" Click="CtxAddBefore_Click"/>
                            <MenuItem Name="CtxAddAfter"  Header="➕ Thêm sau"   Click="CtxAddAfter_Click"/>
                            <Separator/>
                            <MenuItem Name="CtxDelete"    Header="🗑 Xóa"         Click="CtxDelete_Click"/>
                        </ContextMenu>
                    </DataGrid.ContextMenu>

                    <DataGrid.Columns>
                        <!-- Cột #: số thứ tự, không edit, width nhỏ -->
                        <DataGridTextColumn Header="#"
                                           Binding="{Binding Index}"
                                           IsReadOnly="True"
                                           Width="40"/>

                        <!-- Cột Start: Editable inline — bấm F4 để stamp vị trí video -->
                        <DataGridTextColumn Header="Bắt đầu"
                                           Binding="{Binding StartTime,
                                               Converter={StaticResource TimeSpanConverter},
                                               UpdateSourceTrigger=LostFocus}"
                                           IsReadOnly="False"
                                           Width="90">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột End: Editable inline — bấm F4 để stamp vị trí video -->
                        <DataGridTextColumn Header="Kết thúc"
                                           Binding="{Binding EndTime,
                                               Converter={StaticResource TimeSpanConverter},
                                               UpdateSourceTrigger=LostFocus}"
                                           IsReadOnly="False"
                                           Width="90">
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="FontFamily" Value="Consolas"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>

                        <!-- Cột Text: EDITABLE — user có thể sửa trực tiếp -->
                        <DataGridTextColumn Header="Nội dung"
                                           Binding="{Binding Text,
                                               UpdateSourceTrigger=LostFocus}"
                                           Width="*">
                            <!-- Style wrap text nhiều dòng -->
                            <DataGridTextColumn.ElementStyle>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="MaxHeight" Value="60"/>
                                </Style>
                            </DataGridTextColumn.ElementStyle>
                            <DataGridTextColumn.EditingElementStyle>
                                <Style TargetType="TextBox">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="AcceptsReturn" Value="True"/>
                                </Style>
                            </DataGridTextColumn.EditingElementStyle>
                        </DataGridTextColumn>
                    </DataGrid.Columns>
                </DataGrid>

            </Grid><!-- End Panel Phải -->
        </Grid><!-- End Main Content Grid -->
    </Grid><!-- End Root Grid -->
</ui:FluentWindow>
